# ==========================================
# Entornos virtuales y dependencias
# ==========================================
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# ==========================================
# Caché y archivos compilados de Python
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ==========================================
# Variables de entorno y credenciales
# ==========================================
.env
.env.local
.env.*.local
!.env.example

# ==========================================
# Pruebas y Cobertura (Testing & Coverage)
# ==========================================
.pytest_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.ruff_cache/

# ==========================================
# Logs y Bases de Datos Locales
# ==========================================
*.log
*.sqlite
*.sqlite3
*.db

# ==========================================
# Modelos ML generados (Pesados / Binarios)
# Mantener carpeta con .gitkeep
# ==========================================
app/ml_models/*.joblib
app/ml_models/*.pkl
!app/ml_models/.gitkeep

# ==========================================
# Archivos de configuración de IDEs y Editores
# ==========================================
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# ==========================================
# Archivos del Sistema Operativo
# ==========================================
.DS_Store
Thumbs.db
desktop.ini
